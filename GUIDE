/*
 * EcoFuelZ v7.1 Firmware
 * Logic: Pulsed Electrolysis + Safety Monitoring
 */

#include "config.h"

void setup() {
  // Initialize Pins
  pinMode(RELAY_ELECTROLYZER, OUTPUT);
  pinMode(RELAY_HEATER, OUTPUT);
  
  // Safety defaults - Turn everything OFF
  digitalWrite(RELAY_ELECTROLYZER, LOW);
  digitalWrite(RELAY_HEATER, LOW);
  
  Serial.begin(9600);
  Serial.println("EcoFuelZ v7.1 Booting...");
  delay(2000); // Warm up sensors
}

void loop() {
  // 1. Check Safety Systems First
  if (!isSafe()) {
    emergencyShutdown();
    return; // Do nothing until safe
  }

  // 2. Check Battery Voltage
  float voltage = readBatteryVoltage();
  if (voltage < MIN_BATTERY_V) {
    Serial.println("Battery Low - Sleep Mode");
    delay(60000); // Wait 1 min
    return;
  }

  // 3. Run Thermal Management (Simple Bang-Bang Control)
  int tempRaw = analogRead(PIN_TEMP_REACTOR);
  float tempC = convertTemp(tempRaw);
  
  if (tempC < 280) {
    digitalWrite(RELAY_HEATER, HIGH); // Heat ON
  } else {
    digitalWrite(RELAY_HEATER, LOW);  // Heat OFF
  }

  // 4. Run Pulsed Electrolysis (The Efficiency Hack)
  // This pulses the relay to clear bubbles from plates
  digitalWrite(RELAY_ELECTROLYZER, HIGH);
  delay(PULSE_ON_MS);
  
  digitalWrite(RELAY_ELECTROLYZER, LOW);
  delay(PULSE_OFF_MS);
}

// --- Helper Functions ---

bool isSafe() {
  int h2Val = analogRead(PIN_H2_SENSOR);
  
  // If H2 leak is detected
  if (h2Val > H2_THRESHOLD) {
    Serial.print("DANGER: H2 Leak Detected! Val: "); 
    Serial.println(h2Val);
    return false;
  }
  return true;
}

void emergencyShutdown() {
  digitalWrite(RELAY_ELECTROLYZER, LOW);
  digitalWrite(RELAY_HEATER, LOW);
  // Trigger Buzzer/Alarm here if attached
}

float readBatteryVoltage() {
  int sensorValue = analogRead(PIN_VOLTAGE_BUS);
  // Assuming a voltage divider (R1=10k, R2=10k) maps 12V to ~2.5V on Arduino
  // Adjust multiplier based on your actual divider
  float voltage = sensorValue * (5.0 / 1023.0) * 2.0; 
  return voltage;
}

float convertTemp(int rawVal) {
  // Simplified thermistor conversion (Beta equation simplified)
  // For NTC 10k 3950K
  float temp = log(10000.0 * ((1024.0 / rawVal - 1)));
  temp = 1 / (0.001129148 + (0.000234125 + (0.0000000876741 * temp * temp )) * temp );
  temp = temp - 273.15; // Convert Kelvin to Celsius
  return temp;
}


